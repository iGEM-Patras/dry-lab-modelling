; Cycle 3b - membrane-embedded GPCR/peptide complex, Amber ff14SB + Lipid21
integrator              = md
nstlist                 = 20
cutoff-scheme           = Verlet
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = cutoff
vdw-modifier            = potential-shift-verlet
rvdw                    = 1.0
DispCorr                = EnerPres
constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-iter              = 1
lincs-order             = 4
tcoupl                  = V-rescale
tc-grps                 = Protein Other Water_and_ions
ref-t                   = 310 310 310
tau-t                   = 0.5 0.5 0.5
dt                      = 0.002
nsteps                  = 500000          ; 1 ns
pcoupl                  = C-rescale
pcoupltype              = semiisotropic   ; membrane: xy and z couple separately
tau-p                   = 5.0
ref-p                   = 1.0 1.0
compressibility         = 4.5e-5 4.5e-5
continuation            = yes
gen-vel                 = no
nstxout-compressed      = 5000
nstlog                  = 5000
nstenergy               = 5000
