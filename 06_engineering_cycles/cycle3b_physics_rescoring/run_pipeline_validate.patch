>   echo "      built with dres=$BUILT_DRES amide=$BUILT_AMIDE"
>   echo "      table says dres=$SPEC_DRES amide=$SPEC_AMIDE"
>   echo "      The system is not the molecule this job thinks it is -- rebuild."; exit 1
> fi
> echo "  build/run chemistry agree: dres=$SPEC_DRES amide=$SPEC_AMIDE"
