> # SKIPPING all three: a validation pass with the stereochemical checks disarmed.
> # Same defect class that cost the 2026-07-30 build (see scripts/peptide_spec.sh),
> # where c3b_dtII_DOR was built dres=none and came out as the all-L analogue of
> # deltorphin II. Chemistry now comes from prod_all.txt and is cross-checked
> # against what the build actually produced, exactly as run_prod_job.sh does.
> . $W/scripts/peptide_spec.sh
> load_peptide_spec c3b_dtII_DOR || exit 1
> [ -f systems/c3b_dtII_DOR/chem.txt ] || {
>   echo "FAIL: systems/c3b_dtII_DOR/chem.txt missing -- built by an older"
>   echo "      build_system.sh that did not record its chemistry. Rebuild rather"
>   echo "      than assume: a dres=none build is indistinguishable from a correct"
>   echo "      one by inspection of the coordinates."; exit 1; }
> . systems/c3b_dtII_DOR/chem.txt
> if [ "$BUILT_DRES" != "$SPEC_DRES" ] || [ "$BUILT_AMIDE" != "$SPEC_AMIDE" ]; then
