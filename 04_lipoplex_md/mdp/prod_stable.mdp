integrator = md
dt = 0.001
nsteps = 50000000
nstlog = 50000
nstenergy = 50000
nstxout-compressed = 500000
cutoff-scheme = Verlet
coulombtype = reaction-field
rcoulomb = 1.1
epsilon_r = 15
vdw-type = cutoff
rvdw = 1.1
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 310
pcoupl = c-rescale
pcoupltype = isotropic
tau-p = 20.0
compressibility = 3e-4
ref-p = 1.0
gen-vel = no
continuation = yes
define = -DFLEXIBLE
