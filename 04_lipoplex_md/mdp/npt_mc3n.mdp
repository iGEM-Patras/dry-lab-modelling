integrator = md
dt = 0.002
nsteps = 2500000
nstlog = 10000
nstenergy = 10000
nstxout-compressed = 100000
cutoff-scheme = Verlet
coulombtype = reaction-field
rcoulomb = 1.1
epsilon_r = 15
vdw-type = cutoff
rvdw = 1.1
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 310
pcoupl = c-rescale
pcoupltype = isotropic
tau-p = 12.0
compressibility = 3e-4
ref-p = 1.0
gen-vel = yes
gen-temp = 310
gen-seed = 20260724
continuation = no
define = -DFLEXIBLE
